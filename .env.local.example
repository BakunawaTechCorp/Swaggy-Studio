# Copy this file to .env.local and fill in real values.
# Never commit .env.local — and do not paste real keys into THIS example file.

# Supabase — from Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: used server-side only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your Next.js site origin (must match the URL in the browser, e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic — used server-side only for /api/generate-caption (Claude Vision)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Facebook Login for Business — from developers.facebook.com app dashboard.
# Add these redirect URIs in "Facebook Login -> Settings -> Valid OAuth Redirect URIs":
#   http://localhost:3000/api/auth/facebook/callback
#   https://swaggy.studio/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_TOKEN_ENCRYPTION_KEY=your-32-byte-or-longer-random-secret
