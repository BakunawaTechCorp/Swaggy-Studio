# ============================================
# Swaggy Studio — environment variables
# ============================================
# Copy this file to .env.local for local dev.
# Set the same variables in Vercel for production.
# ============================================

# ---- Supabase ----
# Project URL — intentionally public (used by client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key — intentionally public (RLS handles security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SERVER ONLY, never expose to client
# Get from Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- Anthropic (Claude) ----
# SERVER ONLY
ANTHROPIC_API_KEY=sk-ant-api03-...

# ---- Google (Gemini / Imagen) ----
# SERVER ONLY
GEMINI_API_KEY=AIza...

# ---- App config (optional) ----
# Public site URL — used for CSRF same-origin checks and OAuth redirects
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Encryption key for stored Facebook page tokens (rotate if exposed)
# FACEBOOK_TOKEN_ENCRYPTION_KEY=64-char-hex-string

# Optional: override default master user email
# MASTER_USER_EMAIL=admin@example.com

# ---- Feature flags (optional, default off) ----
# NEXT_PUBLIC_FF_MARKETPLACE=0
# NEXT_PUBLIC_FF_MARKETPLACE_MESSAGING=0
# NEXT_PUBLIC_FF_MARKETPLACE_COORD_PAY=0
# NEXT_PUBLIC_FF_MARKETPLACE_ESCROW=0
